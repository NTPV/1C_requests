&НаКлиенте
Процедура ПолучитьЦены(Команда)
	ПолучитьЦеныНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьЦеныНаСервере()
	
	ЭтотОбъект.Объект.Цены.Очистить();
	
	ВидЦенНоменклатуры = ЭтотОбъект.Объект.ВидЦен;
	ДатаЦенНоменклатуры = ЭтотОбъект.Объект.ДатаПрайса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Период КАК Период,
		|	ЦеныНоменклатурыСрезПоследних.ВидЦен КАК ВидЦен,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&ДатаЦенНоменклатуры,
		|			ВидЦен = &ВидЦенНоменклатуры
		|				И Период <= &ДатаЦенНоменклатуры) КАК ЦеныНоменклатурыСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Цена";
	
	Запрос.УстановитьПараметр("ВидЦенНоменклатуры", ВидЦенНоменклатуры);
	Запрос.УстановитьПараметр("ДатаЦенНоменклатуры", ДатаЦенНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ЭтотОбъект.Объект.Цены.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Цена = Выборка.Цена;
		
	КонецЦикла;
	
КонецПроцедуры
