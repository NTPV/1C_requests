&НаКлиенте
Процедура ПеревестиЗаказыКлиентовВДругойСтатус(Команда)
	ПеревестиЗаказыКлиентовВДругойСтатусНаСервере();
	ЭтотОбъект.Элементы.СписокЗаказыКлиентов.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПеревестиЗаказыКлиентовВДругойСтатусНаСервере()
	
	СтатусЗаказа = ЭтотОбъект.Объект.ТекущийСтатус;
	НовыйСтатусЗаказа = ЭтотОбъект.Объект.НовыйСтатус;
	
	Если ЭтотОбъект.Объект.ТекущийСтатус.Пустая() Тогда
		Сообщить("Заполните поле ""Текущий статус""");
		Возврат
	КонецЕсли;
	
	Если ЭтотОбъект.Объект.НовыйСтатус.Пустая() Тогда
		Сообщить("Заполните поле ""Новый статус""");
		Возврат
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	ЗаказКлиента.Номер КАК Номер,
		|	ЗаказКлиента.Дата КАК Дата,
		|	ЗаказКлиента.Проведен КАК Проведен,
		|	ЗаказКлиента.Статус КАК Статус
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Статус = &СтатусЗаказа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("СтатусЗаказа", СтатусЗаказа);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить(ВыборкаДетальныеЗаписи.Номер + " " + ВыборкаДетальныеЗаписи.Дата + " " + ВыборкаДетальныеЗаписи.Статус);
		
		ДокСсылкаЗаказКлиента = ВыборкаДетальныеЗаписи.Ссылка;
		ДокОбъектЗаказКлиента = ДокСсылкаЗаказКлиента.ПолучитьОбъект();
		ДокОбъектЗаказКлиента.Статус = НовыйСтатусЗаказа;
		ДокОбъектЗаказКлиента.Записать()
	КонецЦикла;
	
КонецПроцедуры
