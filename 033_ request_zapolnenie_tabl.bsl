&НаКлиенте
Процедура ЗаполнитьТаблицуОстатков(Команда)
	ЗаполнитьТаблицуОстатковНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОстатковНаСервере()
	
	// Очищаем таблицу перед запросом
	ЭтотОбъект.Объект.ОстаткиТоваров.Очистить();
	// Добавляем параметры для запроса
	Организация = ЭтотОбъект.Объект.Организация;
	Склад = ЭтотОбъект.Объект.Склад;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Организация КАК Организация,
		|	ТоварыНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
		|ГДЕ
		|	ТоварыНаСкладахОстатки.Организация = &Организация
		|	И ТоварыНаСкладахОстатки.Склад = &Склад";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовСтрок = ЭтотОбъект.Объект.ОстаткиТоваров.Добавить();
		НовСтрок.Количество = Выборка.КоличествоОстаток;
		НовСтрок.Номенклатура = Выборка.Номенклатура
	КонецЦикла;
	
КонецПроцедуры
