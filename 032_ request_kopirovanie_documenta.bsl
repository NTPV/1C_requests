&НаКлиенте
Процедура СоздатьЗаказПоставщикуКопированием(Команда)
	СоздатьЗаказПоставщикуКопированиемНаСервере();
	ЭтотОбъект.Элементы.СписокЗаказыПоставщикам.Обновить();
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаказПоставщикуКопированиемНаСервере()
	
	Если ЭтотОбъект.Объект.Контрагент.Пустая()Тогда
		Сообщить("Выберите поставщика в поле ""Поставщик""");
		Возврат
	КонецЕсли;
	
	Поставщик = ЭтотОбъект.Объект.Контрагент; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПоставщику.Ссылка КАК Ссылка,
		|	ЗаказПоставщику.Номер КАК Номер,
		|	ЗаказПоставщику.Дата КАК Дата,
		|	ЗаказПоставщику.Проведен КАК Проведен
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.Проведен = ИСТИНА
		|	И ЗаказПоставщику.Контрагент = &Поставщик
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Сообщить("Не найдено проведенных документов у поставщика: " + Поставщик)
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		Сообщить(Выборка.Ссылка);
		ДокСсылкаЗаказПоставщику = Выборка.Ссылка;
		СкопированныйДокОбъект = ДокСсылкаЗаказПоставщику.Скопировать();
		СкопированныйДокОбъект.Дата = ТекущаяДата();
		СкопированныйДокОбъект.УстановитьНовыйНомер();
		СкопированныйДокОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры
